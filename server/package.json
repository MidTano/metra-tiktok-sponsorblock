{
  "name": "metra-adskip-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev":    "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local":  "wrangler d1 execute metra-adskip --local  --file migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute metra-adskip --remote --file migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^4.167.0",
    "@cloudflare/workers-types": "^4.20250704.0",
    "typescript": "^5.5.0"
  }
}
