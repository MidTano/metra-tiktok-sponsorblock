{
  "name": "metra-adskip",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "account_id": "943ad1cd29711dec0741bbab64061011",

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "metra-adskip",
      "database_id": "c4dc3279-4092-461c-b183-d0fbe7ce0113",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "sponsorblock"
    }
  ],

  // Cloudflare Workers Rate Limit binding: free on Workers Free plan.
  "unsafe": {
    "bindings": [
      {
        "name": "SUBMIT_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 20, "period": 86400 }
      },
      {
        "name": "VOTE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 300, "period": 86400 }
      },
      {
        "name": "READ_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1003",
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  },

  // Daily rebuild at 01:00 UTC (04:00 Moscow).
  "triggers": {
    "crons": ["0 1 * * *"]
  }
}
